# Linux-specific configuration

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/home/marbonestu/.local/google-cloud-sdk/path.zsh.inc' ]; then . '/home/marbonestu/.local/google-cloud-sdk/path.zsh.inc'; fi

# Android Development Environment
[ -f ~/.android-dev-env ] && source ~/.android-dev-env

# Android Studio launcher with Wayland fix
alias android-studio='~/.local/scripts/launch-android-studio.sh'

# Android Emulator helper
alias android-emulator='~/.local/scripts/android-emulator'

# WSL VS Code path (if on WSL)
if [[ -d "/mnt/c/Users" ]]; then
    export PATH=$PATH:/mnt/c/Users/marbo/AppData/Local/Programs/Microsoft\ VS\ Code/bin
fi

# Linux-specific dotnet path
export PATH="$PATH:/home/marbonestu/.dotnet"
export PATH=$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH

# Bun completions (Linux)
[ -s "/home/marbones/.bun/_bun" ] && source "/home/marbones/.bun/_bun"
